# Supply the real credential securely in environment settings, not in this file.
GUIDE_AI_API_KEY=
GUIDE_AI_MODEL=gpt-4.1
GUIDE_PORT=8787
GUIDE_HOST=127.0.0.1
# Use true behind an HTTPS production proxy.
GUIDE_SECURE_COOKIES=false
# Set a deployed HTTPS API before building, or enter its address in the app.
VITE_GUIDE_API_URL=

# Enable Maps JavaScript API and Places API (New) with billing in Google Maps Platform.
# Client key: restrict it to these APIs and your app/web origins.
VITE_GOOGLE_MAPS_API_KEY=

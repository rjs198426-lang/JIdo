{
  "name": "jido-travel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "native:sync": "npm run build && cap sync android",
    "android:build": "bash scripts/build-android.sh",
    "android:open": "cap open android",
    "icons": "node scripts/generate-icons.mjs",
    "server": "node --use-env-proxy --env-file-if-exists=.env server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "prebuild": "node --use-env-proxy scripts/setup-fonts.mjs && npm run assets:prepare",
    "predev": "node --use-env-proxy scripts/setup-fonts.mjs && npm run assets:prepare",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "build:admin": "tsc -b && vite build --mode admin",
    "prebuild:admin": "node --use-env-proxy scripts/setup-fonts.mjs && npm run assets:prepare",
    "dev:admin": "vite --mode admin --open /admin/admin.html",
    "predev:admin": "node --use-env-proxy scripts/setup-fonts.mjs && npm run assets:prepare",
    "content:publish": "node --experimental-strip-types scripts/publish-content.mjs",
    "postbuild": "node scripts/audit-client-build.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/local-notifications": "^8.3.1",
    "express": "^5.3.0",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.56.0",
    "@types/google.maps": "^3.66.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "8.3.4"
  }
}
